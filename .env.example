NODE_ENV=development
PORT=3000
HOST=127.0.0.1
BASE_URL=http://localhost:3000

# Private-ish path for your room. Change this before deploying publicly.
ROOM_PATH=/love-room-demo

# SQLite database location.
DB_PATH=data/app.sqlite

# Weather provider: openmeteo works without a key; openweathermap requires WEATHER_API_KEY.
WEATHER_PROVIDER=openmeteo
WEATHER_API_KEY=

# Upload limits.
MAX_VIDEO_MB=500

# Required in production. Generate a long random string, for example:
# openssl rand -hex 32
ROOM_SECRET=dev-only-change-this-before-production

# Optional external game links shown on the More page.
VTT_URL=
POSIO_URL=

# Set to 1 when deployed behind Nginx or another reverse proxy.
TRUST_PROXY=0

# Optional seed values for scripted deployments.
# Most users should leave these out and complete the first-run setup in the browser.
# PERSON_A_NAME=Person A
# PERSON_A_EMOJI=💛
# PERSON_A_PASSCODE=change-me-a
# PERSON_B_NAME=Person B
# PERSON_B_EMOJI=🌙
# PERSON_B_PASSCODE=change-me-b
# CITY_A_NAME=City A
# CITY_A_TIMEZONE=UTC
# CITY_B_NAME=City B
# CITY_B_TIMEZONE=UTC
# SETUP_COMPLETE=0
